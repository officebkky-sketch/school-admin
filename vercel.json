{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "public/fonts/**"
    }
  },
  "crons": [
    {
      "path": "/api/deadline-reminder",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}